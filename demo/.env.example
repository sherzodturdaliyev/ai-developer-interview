# Copy to demo/.env and fill in. This file is read only by the server; keys never reach the browser.

# ── Gemini: interviewer (required) ──
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini text model available to your key, e.g. gemini-2.5-flash
GEMINI_MODEL=

# ── DeepSeek: technical evaluation (optional; Gemini is used if missing) ──
# Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# e.g. deepseek-chat
DEEPSEEK_MODEL=

# ── Provider routing ──
AI_INTERVIEW_PROVIDER=gemini
AI_INTERVIEW_FALLBACK_PROVIDER=
AI_EVALUATION_PROVIDER=deepseek
AI_EVALUATION_FALLBACK_PROVIDER=gemini

# ── Limits ──
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
PORT=3000
