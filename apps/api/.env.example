# ── Core ──
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview
# Generate with: openssl rand -hex 32  (min 32 chars)
JWT_ACCESS_SECRET=
# bcrypt cost factor (4-15). 12 is a reasonable production value.
BCRYPT_ROUNDS=12
# Max auth requests (login/register/refresh/invite accept) per IP per 15 minutes
AUTH_RATE_LIMIT=50
# Set to 1 when running behind a single reverse proxy (needed for correct client IPs)
TRUST_PROXY=0
LOG_LEVEL=info

# ── AI providers (backend only; never exposed to the browser) ──
# Which provider handles which job. Fallback is optional and must be a different provider.
AI_INTERVIEW_PROVIDER=gemini
AI_INTERVIEW_FALLBACK_PROVIDER=
AI_EVALUATION_PROVIDER=deepseek
AI_EVALUATION_FALLBACK_PROVIDER=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_LIVE_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Optional voice providers ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEEPGRAM_API_KEY=
